---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Method from "../components/Method.astro";
import Navigation from "../components/Navigation.astro";
import Services from "../components/Services.astro";
import { siteFr } from "../content/site.fr";
---

<BaseLayout
  {...siteFr.metadata}
  lang={siteFr.lang}
  skipLinkLabel={siteFr.skipLinkLabel}
>
  <Navigation content={siteFr.navigation} />
  <main id="main-content">
    <Hero content={siteFr.hero} />
    <Services content={siteFr.services} />
    <About content={siteFr.about} />
    <Method content={siteFr.method} />
    <Contact content={siteFr.contact} />
  </main>
  <Footer content={siteFr.footer} />
</BaseLayout>
