---
import BaseLayout from "../../layouts/BaseLayout.astro";
import About from "../../components/About.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import Method from "../../components/Method.astro";
import Navigation from "../../components/Navigation.astro";
import Services from "../../components/Services.astro";
import { siteEn } from "../../content/site.en";
---

<BaseLayout
  {...siteEn.metadata}
  lang={siteEn.lang}
  skipLinkLabel={siteEn.skipLinkLabel}
>
  <Navigation content={siteEn.navigation} />
  <main id="main-content">
    <Hero content={siteEn.hero} />
    <Services content={siteEn.services} />
    <About content={siteEn.about} />
    <Method content={siteEn.method} />
    <Contact content={siteEn.contact} />
  </main>
  <Footer content={siteEn.footer} />
</BaseLayout>
