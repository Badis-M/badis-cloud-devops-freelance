---
const proofItems = [
  "4 ans d’expérience chez Oracle à Genève",
  "Expérience cloud infrastructure et automatisation",
  "Contexte clients suisses et secteur financier",
  "Terraform, CI/CD, Docker, Kubernetes, Linux",
  "Approche orientée documentation, standards et transfert",
];

const technologyGroups = [
  { label: "Cloud", items: "AWS · Azure · OCI" },
  { label: "Infrastructure as Code", items: "Terraform · Ansible" },
  { label: "Containers", items: "Docker · Kubernetes · Helm" },
  { label: "CI/CD", items: "GitHub Actions · GitLab CI" },
  { label: "Systems", items: "Linux · Bash · Networking basics" },
  { label: "Observability", items: "Prometheus · Grafana · Logs · Metrics" },
];
---

<section id="proof" class="section-band scroll-mt-24" aria-labelledby="proof-title">
  <div class="content-container section-space">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-20">
      <div class="max-w-3xl">
        <p class="eyebrow">// EXPÉRIENCE</p>
        <h2 id="proof-title" class="mt-6 text-heading font-semibold text-balance text-ink">
          Des sujets Cloud, DevOps et infrastructure
        </h2>
      </div>
      <p class="max-w-xl text-lead text-muted lg:pb-1">
        J’interviens sur des environnements où la fiabilité, l’automatisation et la clarté
        technique sont essentielles.
      </p>
    </div>

    <div class="mt-16 grid gap-10 lg:mt-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-12">
      <article class="surface-card subtle-glow px-6 py-4 sm:px-9">
        <ul class="divide-y divide-line" role="list">
          {
            proofItems.map((item, index) => (
              <li class="grid grid-cols-[auto_1fr] items-start gap-5 py-6 sm:gap-7 sm:py-7">
                <span class="font-mono text-xs font-semibold tracking-[0.16em] text-accent">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="font-medium leading-6 text-ink">{item}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <div>
        <h3 class="text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl">
          Technologies & environnements
        </h3>

        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            technologyGroups.map((group) => (
              <div
                class="group min-h-32 rounded-card border border-line bg-surface/75 p-6 transition duration-200 hover:-translate-y-1 hover:border-line-strong hover:bg-surface-raised"
              >
                <dt class="font-mono text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                  {group.label}
                </dt>
                <dd class="mt-4 text-sm font-medium leading-6 text-ink sm:text-base">
                  {group.items}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
