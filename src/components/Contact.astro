---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["contact"];
}

const { content } = Astro.props;

const fieldClass =
  "mt-2 min-h-13 w-full rounded-xl border border-line bg-white/[0.025] px-4 py-3 text-sm text-ink shadow-inner shadow-black/20 transition-colors placeholder:text-subtle focus:border-accent";
---

<section id="contact" class="section-band scroll-mt-24" aria-labelledby="contact-title">
  <div class="content-container section-space">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">{content.label}</p>
      <h2 id="contact-title" class="mt-6 text-heading font-semibold text-balance text-ink">
        {content.heading[0]}<br class="hidden sm:block" /> {content.heading[1]}
      </h2>
      <p class="mx-auto mt-7 max-w-3xl text-lead text-muted">
        {content.introduction}
      </p>
    </div>

  <div class="mt-16 grid gap-6 lg:mt-20 lg:grid-cols-2 lg:items-start">
    <form
      id="contact-form"
      class="surface-card subtle-glow p-6 sm:p-8 lg:p-10"
      action="https://formspree.io/f/xyeykrvl"
      method="POST"
      aria-labelledby="contact-form-title"
      aria-describedby="contact-form-helper"
      data-error-message={content.errorMessage}
    >
      <input type="hidden" name="_subject" value={content.subject} />
      <!-- Add Turnstile or another spam protection here if spam becomes an issue. -->

      <div class="border-b border-line pb-7">
        <h3 id="contact-form-title" class="text-2xl font-semibold tracking-[-0.025em] text-ink">
          {content.formTitle}
        </h3>
      </div>

      <fieldset class="mt-7 grid gap-5 sm:grid-cols-2">
        <legend class="sr-only">{content.formLegend}</legend>

        <label class="block font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-muted uppercase" for="contact-name">
          {content.fields.name}
          <input
            id="contact-name"
            class={fieldClass}
            type="text"
            name="name"
            autocomplete="name"
            required
          />
        </label>

        <label class="block font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-muted uppercase" for="contact-organization">
          {content.fields.company}
          <input
            id="contact-organization"
            class={fieldClass}
            type="text"
            name="company"
            autocomplete="organization"
          />
        </label>

        <label class="block font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-muted uppercase sm:col-span-2" for="contact-email">
          {content.fields.email}
          <input
            id="contact-email"
            class={fieldClass}
            type="email"
            name="email"
            autocomplete="email"
            required
          />
        </label>

        <label class="block font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-muted uppercase" for="contact-service">
          {content.fields.service}
          <select id="contact-service" class={fieldClass} name="service" required>
            <option value="">{content.fields.servicePlaceholder}</option>
            {content.serviceOptions.map((service) => <option value={service}>{service}</option>)}
          </select>
        </label>

        <label class="block font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-muted uppercase" for="contact-budget">
          {content.fields.budget}
          <input id="contact-budget" class={fieldClass} type="text" name="budget" />
        </label>

        <label class="block font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-muted uppercase sm:col-span-2" for="contact-message">
          {content.fields.message}
          <textarea
            id="contact-message"
            class={`${fieldClass} min-h-36 resize-y`}
            name="message"
            rows="6"
            required
          ></textarea>
        </label>

        <div class="pt-2 sm:col-span-2">
          <button
            id="contact-submit"
            class="button button-primary w-full disabled:cursor-wait disabled:opacity-70"
            type="submit"
            data-default-label={content.submitLabel}
            data-submitting-label={content.submittingLabel}
          >
            {content.submitLabel}
          </button>
          <p
            id="contact-form-error"
            class="mt-4 text-sm leading-6 text-red-300"
            role="alert"
            aria-live="assertive"
            hidden
          ></p>
        </div>
      </fieldset>

      <p id="contact-form-helper" class="mt-5 text-sm leading-6 text-muted">
        {content.helperText}
      </p>
      <p class="mt-3 text-xs leading-6 text-subtle">
        {content.privacyNotice}{" "}
        <a
          class="font-medium text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent"
          href={content.privacyHref}
        >
          {content.privacyLinkLabel}
        </a>
      </p>
    </form>

    <aside class="surface-card p-7 sm:p-9 lg:p-11" aria-label={content.asideAriaLabel}>
      <div>
        <div class="flex items-center gap-3">
          <span
            class="h-3 w-3 shrink-0 rounded-full bg-accent shadow-[0_0_16px_rgba(103,232,249,0.65)]"
            aria-hidden="true"
          ></span>
          <h3 class="font-semibold text-ink">{content.availabilityTitle}</h3>
        </div>

        <ul class="mt-9 divide-y divide-line" role="list">
          {
            content.availabilityItems.map((item) => (
              <li class="flex items-start gap-3.5 py-4.5 first:pt-0 last:pb-0">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span class="text-sm leading-7 text-muted">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-11 border-t border-line pt-10">
        <h3 class="font-mono text-xs font-semibold tracking-[0.18em] text-subtle uppercase">
          {content.timelineTitle}
        </h3>
        <dl class="mt-7 divide-y divide-line rounded-2xl border border-line bg-canvas/45 px-6 py-2 sm:px-7">
          {
            content.timelineItems.map((item) => (
              <div class="grid gap-2 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6">
                <dt class="text-sm leading-6 text-muted">{item.label}</dt>
                <dd class="font-mono text-sm font-semibold leading-6 text-ink sm:text-right">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </div>
  </div>
</section>

<dialog
  id="contact-success-dialog"
  class="m-auto w-[calc(100%-2rem)] max-w-md border-0 bg-transparent p-0 text-ink backdrop:bg-black/75 backdrop:backdrop-blur-sm"
  aria-labelledby="contact-success-title"
  aria-describedby="contact-success-description"
>
  <div
    class="rounded-[var(--radius-card)] border border-line-strong bg-surface-raised p-7 shadow-[0_32px_100px_rgb(0_0_0/0.55)] sm:p-8"
  >
    <p class="eyebrow">{content.confirmationLabel}</p>
    <h3 id="contact-success-title" class="mt-5 text-2xl font-semibold tracking-[-0.025em] text-ink">
      {content.successTitle}
    </h3>
    <p id="contact-success-description" class="mt-4 leading-7 text-muted">
      {content.successMessage}
    </p>
    <button
      id="contact-success-close"
      class="button button-primary mt-7 w-full"
      type="button"
      autofocus
    >
      {content.closeLabel}
    </button>
  </div>
</dialog>

<script>
  const form = document.querySelector("#contact-form");
  const submitButton = document.querySelector("#contact-submit");
  const errorMessage = document.querySelector("#contact-form-error");
  const successDialog = document.querySelector("#contact-success-dialog");
  const closeButton = document.querySelector("#contact-success-close");

  if (
    form instanceof HTMLFormElement &&
    submitButton instanceof HTMLButtonElement &&
    errorMessage instanceof HTMLParagraphElement &&
    successDialog instanceof HTMLDialogElement &&
    closeButton instanceof HTMLButtonElement
  ) {
    const defaultButtonText = submitButton.dataset.defaultLabel ?? submitButton.textContent ?? "";
    const submittingButtonText = submitButton.dataset.submittingLabel ?? defaultButtonText;
    const submissionErrorMessage = form.dataset.errorMessage ?? "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorMessage.hidden = true;
      errorMessage.textContent = "";
      submitButton.disabled = true;
      submitButton.textContent = submittingButtonText;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        if (!response.ok) {
          throw new Error(`Formspree returned status ${response.status}.`);
        }

        form.reset();
        successDialog.showModal();
        closeButton.focus();
      } catch (error) {
        console.error("Contact form submission failed.", error);
        errorMessage.textContent = submissionErrorMessage;
        errorMessage.hidden = false;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = defaultButtonText;
      }
    });

    closeButton.addEventListener("click", () => {
      successDialog.close();
    });

    successDialog.addEventListener("close", () => {
      submitButton.focus();
    });
  }
</script>
