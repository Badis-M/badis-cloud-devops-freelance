---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["services"];
}

const { content } = Astro.props;
---

<section id="services" class="section-band scroll-mt-24" aria-labelledby="services-title">
  <div class="content-container section-space">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">{content.label}</p>
      <h2 id="services-title" class="mt-6 text-heading font-semibold text-balance text-ink">
        {content.heading[0]}<br class="hidden sm:block" /> {content.heading[1]}
      </h2>
      <p class="mx-auto mt-7 max-w-3xl text-lead text-muted">
        {content.introduction}
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      {
        content.offers.map((service, index) => (
          <article class="surface-card group flex h-full min-h-[31rem] flex-col p-7 hover:-translate-y-0.5 hover:shadow-[0_28px_80px_rgb(0_0_0/0.36)] sm:p-8 lg:p-9">
            <div class="flex items-center justify-between gap-4">
              <p class="eyebrow">{service.category}</p>
              <span class="font-mono text-xs text-subtle">{String(index + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="mt-7 text-2xl font-semibold tracking-[-0.03em] text-balance text-ink lg:text-[1.7rem]">
              {service.title}
            </h3>
            <p class="mt-5 leading-7 text-muted">{service.description}</p>

            <ul class="mt-7 space-y-4 border-t border-line pt-6" role="list">
              {service.bullets.map((bullet) => (
                <li class="flex gap-3 text-sm leading-6 text-muted">
                  <span
                    class="mt-1 flex size-4 shrink-0 items-center justify-center rounded-full border border-line-strong bg-accent/10 text-[0.625rem] font-bold text-accent"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <a
              class="mt-auto inline-flex w-fit items-center border-b border-accent/30 pt-8 pb-1 font-semibold text-accent no-underline transition-colors hover:border-ink hover:text-ink"
              href="#contact"
            >
              {service.cta}
            </a>
          </article>
        ))
      }
    </div>

    <article
      class="surface-card mt-6 grid gap-9 p-7 sm:p-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(26rem,1.1fr)] lg:items-center lg:gap-12 lg:p-10"
      aria-labelledby="training-title"
    >
      <div>
        <p class="eyebrow">{content.training.label}</p>
        <h3 id="training-title" class="mt-6 text-3xl font-semibold tracking-[-0.035em] text-balance text-ink">
          {content.training.title}
        </h3>
        <p class="mt-5 leading-7 text-muted">
          {content.training.description}
        </p>
        <a
          class="mt-7 inline-flex w-fit items-center border-b border-accent/30 pb-1 font-semibold text-accent no-underline transition-colors hover:border-ink hover:text-ink"
          href="#contact"
        >
          {content.training.cta}
        </a>
      </div>

      <ul class="grid gap-3" role="list">
        {
          content.training.bullets.map((bullet) => (
            <li class="flex items-start gap-3 rounded-xl border border-line bg-canvas/35 px-4 py-4 text-sm leading-6 text-muted sm:px-5">
              <span
                class="mt-1 flex size-4 shrink-0 items-center justify-center rounded-full border border-line-strong bg-accent/10 text-[0.625rem] font-bold text-accent"
                aria-hidden="true"
              >
                ✓
              </span>
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <article class="rounded-[var(--radius-card)] border border-line bg-surface/60 p-7 sm:p-8">
        <p class="eyebrow">{content.problems.label}</p>
        <h3 class="mt-5 text-2xl font-semibold tracking-[-0.03em] text-ink">
          {content.problems.title}
        </h3>
        <ul class="mt-7 grid gap-4 sm:grid-cols-2" role="list">
          {
            content.problems.items.map((problem) => (
              <li class="flex items-start gap-3 text-sm leading-6 text-muted">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{problem}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="rounded-[var(--radius-card)] border border-line bg-surface/60 p-7 sm:p-8">
        <p class="eyebrow">{content.formats.label}</p>
        <h3 class="mt-5 text-2xl font-semibold tracking-[-0.03em] text-ink">
          {content.formats.title}
        </h3>
        <dl class="mt-7 divide-y divide-line">
          {
            content.formats.items.map((format) => (
              <div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[auto_1fr] sm:gap-3">
                <dt class="font-semibold text-ink">{format.label}</dt>
                <dd class="text-sm leading-6 text-muted sm:text-right">{format.detail}</dd>
              </div>
            ))
          }
        </dl>
      </article>
    </div>

    <p class="mt-6 flex items-start gap-3 rounded-2xl border border-line bg-accent/[0.035] px-5 py-4 text-sm leading-7 text-muted sm:px-6">
      <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
      <span>{content.aiNote}</span>
    </p>
  </div>
</section>
