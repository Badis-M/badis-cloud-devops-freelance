---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["navigation"];
}

const { content } = Astro.props;
---

<header
  id="site-navigation"
  class="sticky top-0 z-40 border-b border-line bg-canvas/75 backdrop-blur-xl"
>
  <div
    class="content-container grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 py-3 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]"
  >
    <a
      class="inline-flex w-fit items-center gap-2.5 text-sm font-semibold tracking-tight text-ink no-underline"
      href="#hero"
      aria-label="Badis Merakchi"
    >
      <span
        class="flex size-8 items-center justify-center rounded-lg bg-white/[0.035] font-mono text-[0.625rem] text-accent ring-1 ring-white/[0.08]"
      >
        BM
      </span>
      <span class="hidden min-[24rem]:inline">
        Badis Merakchi
        <span class="hidden font-normal text-subtle lg:inline"> · Cloud & DevOps</span>
      </span>
    </a>

    <nav class="hidden md:block" aria-label={content.ariaLabel}>
      <ul class="flex items-center gap-7 text-sm">
        <li><a class="nav-link" href="#services">{content.services}</a></li>
        <li><a class="nav-link" href="#about">{content.about}</a></li>
        <li><a class="nav-link" href="#method">{content.method}</a></li>
      </ul>
    </nav>

    <div class="flex items-center justify-self-end gap-2 sm:gap-3">
      <a
        class="inline-flex min-h-10 items-center justify-center rounded-xl border border-line px-3 font-mono text-xs font-semibold tracking-[0.12em] text-muted no-underline transition-colors hover:border-line-strong hover:text-ink"
        href={content.languageSwitch.href}
        hreflang={content.languageSwitch.targetLang}
        lang={content.languageSwitch.targetLang}
        aria-label={content.languageSwitch.label}
      >
        {content.languageSwitch.code}
      </a>
      <a class="button button-secondary min-h-10 rounded-xl px-4 py-2" href="#contact">
        {content.contact}
      </a>
    </div>
  </div>
</header>
