---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["privacy"];
}

const { content } = Astro.props;
---

<header class="border-b border-line bg-canvas/80 backdrop-blur-xl">
  <div class="content-container flex items-center justify-between gap-4 py-4">
    <a
      class="inline-flex items-center gap-2.5 text-sm font-semibold tracking-tight text-ink no-underline"
      href={content.homeHref}
      aria-label="Badis Merakchi"
    >
      <span
        class="flex size-8 items-center justify-center rounded-lg bg-white/[0.035] font-mono text-[0.625rem] text-accent ring-1 ring-white/[0.08]"
      >
        BM
      </span>
      <span class="hidden min-[24rem]:inline">Badis Merakchi</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        class="inline-flex min-h-10 items-center justify-center rounded-xl border border-line px-3 font-mono text-xs font-semibold tracking-[0.12em] text-muted no-underline transition-colors hover:border-line-strong hover:text-ink"
        href={content.languageSwitch.href}
        hreflang={content.languageSwitch.targetLang}
        lang={content.languageSwitch.targetLang}
        aria-label={content.languageSwitch.label}
      >
        {content.languageSwitch.code}
      </a>
      <a class="button button-secondary min-h-10 rounded-xl px-4 py-2" href={content.homeHref}>
        {content.homeLabel}
      </a>
    </div>
  </div>
</header>

<main id="main-content" class="content-container py-16 sm:py-20 lg:py-24">
  <article class="mx-auto max-w-3xl">
    <header>
      <p class="eyebrow">{content.label}</p>
      <h1 class="mt-6 text-heading font-semibold text-balance text-ink">{content.title}</h1>
      <p class="mt-7 max-w-2xl text-lead text-muted">{content.introduction}</p>
      <p class="mt-5 font-mono text-xs tracking-[0.08em] text-subtle uppercase">
        {content.updatedLabel} · {content.updatedDate}
      </p>
    </header>

    <div class="mt-14 border-t border-line">
      {
        content.sections.map((section) => (
          <section class="border-b border-line py-9 sm:py-10">
            <h2 class="text-xl font-semibold tracking-[-0.02em] text-ink sm:text-2xl">
              {section.title}
            </h2>

            <div class="mt-5 space-y-4">
              {section.paragraphs.map((paragraph) => (
                <p class="leading-7 text-muted">{paragraph}</p>
              ))}
            </div>

            {section.items && (
              <ul class="mt-5 grid gap-3 text-sm leading-6 text-muted sm:grid-cols-2" role="list">
                {section.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {section.link && (
              <a
                class="mt-6 inline-flex w-fit border-b border-accent/30 pb-1 text-sm font-semibold text-accent no-underline transition-colors hover:border-ink hover:text-ink"
                href={section.link.href}
                target={section.link.external ? "_blank" : undefined}
                rel={section.link.external ? "noreferrer" : undefined}
              >
                {section.link.label}
              </a>
            )}
          </section>
        ))
      }
    </div>
  </article>
</main>

<footer class="border-t border-line bg-canvas/90">
  <div class="content-container flex flex-col gap-3 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© 2026 Badis Merakchi</p>
    <a class="w-fit font-medium text-ink transition-colors hover:text-accent" href={content.homeHref}>
      {content.homeLabel}
    </a>
  </div>
</footer>
