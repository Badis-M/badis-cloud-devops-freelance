---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["about"];
}

const { content } = Astro.props;

const credibilityIcons = [
  [
      "M4 19.5A2.5 2.5 0 0 1 6.5 17H20",
      "M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z",
  ],
  ["M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"],
  ["m4 17 6-6-6-6", "M12 19h8"],
  ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20", "M12 6v6l4 2"],
];
---

<section id="about" class="content-container section-space scroll-mt-24" aria-labelledby="about-title">
  <div class="grid gap-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(30rem,1.1fr)] lg:items-center lg:gap-20">
    <div class="max-w-2xl lg:max-w-xl">
      <p class="eyebrow">{content.label}</p>
      <h2 id="about-title" class="mt-6 text-heading font-semibold text-balance text-ink lg:max-w-lg">
        {content.heading[0]}<br />{content.heading[1]}
      </h2>

      <span class="mt-8 block h-px w-14 bg-accent/70" aria-hidden="true"></span>

      <p class="mt-8 text-lead font-medium text-ink/90">
        {content.introduction}
      </p>

      <div class="mt-7 space-y-5">
        {content.paragraphs.map((paragraph) => <p class="leading-7 text-muted">{paragraph}</p>)}
      </div>

      <p class="mt-8 flex items-center gap-3 border-t border-line pt-6 text-sm font-medium text-ink/85">
        <svg
          class="size-5 shrink-0 text-accent"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="2.5"></circle>
        </svg>
        {content.location}
      </p>

      <div class="mt-7 border-l border-line-strong pl-5">
        <p class="max-w-lg text-sm leading-6 text-muted">
          {content.verificationText}
        </p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          <a
            class="text-ink/80 underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent focus-visible:text-accent"
            href="https://portfolio.badismerakchi.com"
            target="_blank"
            rel="noreferrer"
          >
            {content.portfolioLabel}
          </a>
          <a
            class="text-ink/80 underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent focus-visible:text-accent"
            href="https://github.com/Badis-M"
            target="_blank"
            rel="noreferrer"
          >
            {content.githubLabel}
          </a>
        </div>
      </div>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:gap-5" aria-label={content.cardsAriaLabel} role="list">
      {
        content.cards.map((card, index) => (
          <li class="group flex min-h-48 flex-col rounded-2xl border border-line bg-surface/70 p-6 transition-[border-color,background-color,transform] duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:bg-surface-raised/75 sm:min-h-52 sm:p-7">
            <span class="flex size-11 items-center justify-center rounded-xl border border-line-strong bg-canvas/45 text-accent transition-colors group-hover:border-accent/45 group-hover:bg-accent/[0.07]">
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {credibilityIcons[index]?.map((path) => <path d={path}></path>)}
              </svg>
            </span>
            <div class="mt-auto pt-8">
              <h3 class="text-lg font-semibold tracking-[-0.02em] text-ink">{card.title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{card.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
