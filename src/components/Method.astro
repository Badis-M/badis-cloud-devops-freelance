---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["method"];
}

const { content } = Astro.props;
---

<section id="method" class="section-band scroll-mt-24" aria-labelledby="method-title">
  <div class="content-container section-space">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">{content.label}</p>
      <h2 id="method-title" class="mt-6 text-heading font-semibold text-balance text-ink">
        {content.heading[0]}<br class="hidden sm:block" /> {content.heading[1]}
      </h2>
      <p class="mx-auto mt-7 max-w-3xl text-lead text-muted">
        {content.introduction}
      </p>
    </div>

    <ol class="relative mx-auto mt-14 max-w-6xl before:absolute before:top-8 before:right-[12.5%] before:left-[12.5%] before:hidden before:border-t before:border-dashed before:border-accent/30 before:content-[''] lg:grid lg:grid-cols-4 lg:before:block lg:mt-18">
      {
        content.steps.map((step, index) => (
          <li class="group relative grid grid-cols-[4rem_minmax(0,1fr)] gap-6 border-b border-line py-8 first:pt-0 last:border-b-0 last:pb-0 lg:block lg:border-b-0 lg:px-6 lg:py-0 xl:px-8">
            <span class="relative z-10 flex size-16 items-center justify-center rounded-full border border-line-strong bg-surface font-mono text-sm font-semibold tracking-[0.12em] text-accent transition-colors group-hover:border-accent group-hover:bg-surface-raised lg:mx-auto">
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="pt-1 lg:mt-8 lg:pt-0 lg:text-center">
              <h3 class="text-2xl font-semibold tracking-[-0.03em] text-ink">{step.title}</h3>
              <p class="mt-4 max-w-2xl leading-[1.75] text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
