---
import type { SiteContent } from "../content/types";

interface Props {
  content: SiteContent["footer"];
}

const { content } = Astro.props;
---

<footer id="site-footer" class="relative overflow-hidden border-t border-line bg-canvas/90">
  <div
    class="pointer-events-none absolute top-0 right-0 h-56 w-96 bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.08),transparent_70%)]"
    aria-hidden="true"
  ></div>
  <div class="content-container relative py-14 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.35fr_0.8fr_0.8fr] lg:gap-14">
      <div class="max-w-sm">
        <a
          class="inline-flex items-center gap-3 text-lg font-semibold tracking-tight text-ink no-underline transition-colors hover:text-accent"
          href="#hero"
        >
          <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-line-strong bg-accent/10 font-mono text-xs text-accent">
            BM
          </span>
          Badis Merakchi
        </a>
        <p class="mt-4 text-sm leading-6 text-muted">
          {content.tagline}
        </p>
      </div>

      <nav aria-label={content.navigationAriaLabel}>
        <p class="font-mono text-[0.65rem] font-semibold tracking-[0.2em] text-subtle uppercase">
          {content.navigationTitle}
        </p>
        <ul class="mt-5 grid gap-3 text-sm text-muted">
          <li><a class="transition-colors hover:text-ink" href="#services">{content.services}</a></li>
          <li><a class="transition-colors hover:text-ink" href="#about">{content.about}</a></li>
          <li><a class="transition-colors hover:text-ink" href="#method">{content.method}</a></li>
          <li><a class="transition-colors hover:text-ink" href="#contact">{content.contact}</a></li>
        </ul>
      </nav>

      <div aria-labelledby="footer-links-title">
        <p
          id="footer-links-title"
          class="font-mono text-[0.65rem] font-semibold tracking-[0.2em] text-subtle uppercase"
        >
          {content.linksTitle}
        </p>
        <ul class="mt-5 grid gap-3 text-sm">
          <li>
            <a
              class="font-medium text-ink transition-colors hover:text-accent"
              href="https://portfolio.badismerakchi.com"
              target="_blank"
              rel="noreferrer"
            >
              {content.portfolio}
            </a>
          </li>
          <li>
            <a
              class="text-muted transition-colors hover:text-ink"
              href="https://www.linkedin.com/in/merakchi/"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              class="text-muted transition-colors hover:text-ink"
              href="https://github.com/Badis-M"
              target="_blank"
              rel="noreferrer"
            >
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-7">
      <p class="text-xs leading-5 text-subtle">
        {content.copyright}
      </p>
    </div>
  </div>
</footer>
